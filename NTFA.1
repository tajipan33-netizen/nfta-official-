
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#061b16">
<title>NFTA OFFICIAL</title>
<style>
:root{--bg:#061b16;--panel:#102b23;--line:#285344;--green:#79edb2;--text:#f2fff8;--muted:#a9c5b8}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
header{padding:20px 16px;border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:12px}
.logo{border:2px solid var(--green);border-radius:12px;padding:9px;color:var(--green);font-weight:bold}
h1{font-size:22px;margin:0 0 5px}
small,.muted{color:var(--muted)}
nav{display:flex;gap:8px;padding:12px;overflow-x:auto}
nav button{white-space:nowrap}
button,input,select,textarea{font:inherit}
button{background:#18392d;color:var(--text);border:1px solid var(--line);border-radius:10px;padding:11px 14px;cursor:pointer}
button.active,button.primary{background:var(--green);color:#062018;border-color:var(--green);font-weight:bold}
main{padding:12px;max-width:850px;margin:auto}
section{display:none}
section.active{display:block}
.card{background:var(--panel);border:1px solid var(--line);border-radius:15px;padding:16px;margin:12px 0}
h2{font-size:20px;margin:5px 0 14px}
h3{margin:0 0 8px}
p{line-height:1.5}
input,select,textarea{width:100%;padding:12px;margin:6px 0 12px;background:#061b16;color:var(--text);border:1px solid var(--line);border-radius:9px}
label{font-size:14px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.stat{background:#0a241c;border-radius:12px;padding:14px}
.stat strong{display:block;font-size:25px;color:var(--green)}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px}
.tag{color:var(--green);font-size:12px}
.notice{padding:12px;border:1px solid var(--line);border-radius:10px;color:var(--muted);font-size:13px}
footer{text-align:center;padding:25px;color:var(--muted);font-size:12px}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="logo">NF</div>
    <div><h1>NFTA OFFICIAL</h1><small>NEW FANTASY LEAGUE · 공식 홈페이지</small></div>
  </div>
</header>

<nav id="nav">
  <button class="active" data-page="home">홈</button>
  <button data-page="news">리그 뉴스</button>
  <button data-page="fixtures">일정·결과</button>
  <button data-page="clubs">구단·선수단</button>
  <button data-page="register">구단 등록</button>
  <button data-page="players">선수 등록</button>
  <button data-page="admin">관리자</button>
</nav>

<main>
<section id="home" class="active">
  <div class="card">
    <span class="tag">OFFICIAL LEAGUE</span>
    <h2 style="font-size:28px">새로운 환상팀대결</h2>
    <p class="muted">뉴판타지리그의 일정, 구단, 선수와 최신 소식을 확인하세요.</p>
    <button class="primary" onclick="showPage('fixtures')">경기 일정 보기</button>
    <button onclick="showPage('register')">구단 등록 신청</button>
  </div>
  <div class="grid">
    <div class="stat"><strong id="clubCount">0</strong><span>등록 구단</span></div>
    <div class="stat"><strong id="playerCount">0</strong><span>등록 선수</span></div>
  </div>
  <div class="card"><h3>📢 공지사항</h3><p class="muted">공식 리그 소식을 이곳에서 확인하세요.</p></div>
  <div class="notice">현재 버전은 브라우저 저장 방식의 기본 화면입니다. 여러 기기 간 공유와 관리자 승인은 서버 연결이 필요합니다.</div>
</section>

<section id="news">
  <div class="card"><h2>리그 뉴스</h2><p class="muted">공식 뉴스 및 경기 소식</p></div>
  <div id="newsList"></div>
  <div class="card">
    <h3>뉴스 작성 미리보기</h3>
    <label>제목</label><input id="newsTitle" placeholder="뉴스 제목">
    <label>내용</label><textarea id="newsBody" rows="4" placeholder="뉴스 내용을 입력하세요"></textarea>
    <label>사진 선택</label><input id="newsPhoto" type="file" accept="image/*">
    <button class="primary" onclick="addNews()">뉴스 추가</button>
    <p class="muted">현재는 이 브라우저에만 저장됩니다. 공개 뉴스 게시에는 서버 연결이 필요합니다.</p>
  </div>
</section>

<section id="fixtures">
  <div class="card"><h2>경기 일정 · 결과</h2>
    <p class="muted">기존 공식 15라운드 일정을 확인할 수 있도록 구성했습니다.</p>
    <label>라운드 선택</label>
    <select id="roundSelect" onchange="renderFixtures()"></select>
    <div id="fixtureList"></div>
  </div>
  <div class="notice">기존에 정한 120경기 대진표는 아직 이 새 파일에 입력되지 않았습니다. 정확한 대진표 데이터를 연결한 뒤 표시해야 합니다.</div>
</section>

<section id="clubs">
  <div class="card"><h2>구단 목록</h2><p class="muted">구단을 누르면 소속 선수 목록을 확인할 수 있습니다.</p></div>
  <div id="clubList"></div>
  <div id="squadView"></div>
</section>

<section id="register">
  <div class="card">
    <h2>구단 등록 신청</h2>
    <p class="muted">구단 정보를 입력하세요.</p>
    <form id="clubForm">
      <label>구단명</label><input id="clubName" required placeholder="예: ASTRA FC">
      <label>대표자</label><input id="clubOwner" required placeholder="대표자 이름">
      <label>연락처 또는 이메일</label><input id="clubContact" required placeholder="연락 가능한 정보">
      <label>구단 소개</label><textarea id="clubDescription" rows="3" placeholder="구단 소개"></textarea>
      <button class="primary" type="submit">등록 신청</button>
    </form>
    <div id="clubMessage"></div>
  </div>
</section>

<section id="players">
  <div class="card">
    <h2>선수 등록</h2>
    <form id="playerForm">
      <label>소속 구단</label><select id="playerClub" required></select>
      <label>선수 이름</label><input id="playerName" required placeholder="선수 이름">
      <label>포지션</label>
      <select id="playerPosition"><option>GK</option><option>DF</option><option>MF</option><option>FW</option></select>
      <label>등번호</label><input id="playerNumber" type="number" min="1" max="99" placeholder="등번호">
      <label>선수 사진</label><input id="playerPhoto" type="file" accept="image/*">
      <button class="primary" type="submit">선수 등록</button>
    </form>
    <div id="playerMessage"></div>
  </div>
</section>

<section id="admin">
  <div class="card">
    <h2>관리자 메뉴</h2>
    <p class="muted">현재는 이 브라우저의 신청 내역을 확인하는 기본 화면입니다. 실제 관리자 로그인 기능은 아직 연결되지 않았습니다.</p>
    <label>관리자 확인용 비밀번호</label>
    <input id="adminPassword" type="password" placeholder="이 화면에서만 사용하는 임시 비밀번호">
    <button onclick="showAdmin()">신청 내역 확인</button>
    <div id="adminResults"></div>
  </div>
  <div class="notice">중요: 이 임시 화면은 보안 인증이 아닙니다. 실제 운영 전에 서버 기반 관리자 로그인과 승인 권한을 연결해야 합니다.</div>
</section>
</main>
<footer>NFTA OFFICIAL · New Fantasy League</footer>

<script>
const $=id=>document.getElementById(id);
const read=(key)=>{try{return JSON.parse(localStorage.getItem("nfta_"+key)||"[]")}catch{return []}};
const save=(key,data)=>localStorage.setItem("nfta_"+key,JSON.stringify(data));
let selectedClub=null;

function showPage(page){
 document.querySelectorAll("main section").forEach(s=>s.classList.toggle("active",s.id===page));
 document.querySelectorAll("#nav button").forEach(b=>b.classList.toggle("active",b.dataset.page===page));
 if(page==="clubs")renderClubs();
 if(page==="fixtures")renderFixtures();
 if(page==="news")renderNews();
 window.scrollTo(0,0);
}
$("nav").addEventListener("click",e=>{
 const b=e.target.closest("button[data-page]");
 if(b)showPage(b.dataset.page);
});
for(let i=1;i<=15;i++){
 const o=document.createElement("option");
 o.value=i;o.textContent=i+"라운드";
 $("roundSelect").appendChild(o);
}

function updateStats(){
 $("clubCount").textContent=read("clubs").filter(c=>c.status==="승인").length;
 $("playerCount").textContent=read("players").length;
 const select=$("playerClub"),old=select.value;
 select.innerHTML="";
 read("clubs").filter(c=>c.status==="승인").forEach(c=>{
  const o=document.createElement("option");o.value=c.name;o.textContent=c.name;select.appendChild(o);
 });
 if(old)select.value=old;
}
$("clubForm").addEventListener("submit",e=>{
 e.preventDefault();
 const name=$("clubName").value.trim();
 const clubs=read("clubs");
 if(clubs.some(c=>c.name.toLowerCase()===name.toLowerCase())){
  $("clubMessage").textContent="이미 신청된 구단명입니다.";return;
 }
 clubs.push({id:Date.now(),name,owner:$("clubOwner").value.trim(),
 contact:$("clubContact").value.trim(),description:$("clubDescription").value.trim(),
 status:"검토 대기"});
 save("clubs",clubs);
 $("clubMessage").textContent="신청이 이 브라우저에 저장되었습니다. 실제 관리자에게 전달된 것은 아닙니다.";
 e.target.reset();renderClubs();updateStats();
});
$("playerForm").addEventListener("submit",async e=>{
 e.preventDefault();
 const name=$("playerName").value.trim(),club=$("playerClub").value;
 if(!club){$("playerMessage").textContent="승인된 구단이 먼저 필요합니다.";return}
 let photo="";
 const file=$("playerPhoto").files[0];
 if(file){
  if(file.size>500000){$("playerMessage").textContent="사진은 500KB 이하로 선택해 주세요.";return}
  photo=await fileToDataURL(file);
 }
 const players=read("players");
 players.push({id:Date.now(),club,name,position:$("playerPosition").value,
 number:$("playerNumber").value,photo});
 save("players",players);e.target.reset();
 $("playerMessage").textContent="선수 정보가 이 브라우저에 저장되었습니다.";
 updateStats();renderClubs();
});
function fileToDataURL(file){return new Promise((resolve,reject)=>{
 const r=new FileReader();r.onload=()=>resolve(r.result);r.onerror=reject;r.readAsDataURL(file);
})}
function renderClubs(){
 const clubs=read("clubs");
 $("clubList").innerHTML="";
 if(!clubs.length)$("clubList").innerHTML='<div class="card muted">등록된 구단이 없습니다.</div>';
 clubs.forEach(c=>{
  const d=document.createElement("div");d.className="card";
  d.innerHTML='<div class="row"><h3></h3><span class="tag"></span></div><p class="muted"></p><button>선수단 보기</button>';
  d.querySelector("h3").textContent=c.name;
  d.querySelector(".tag").textContent=c.status;
  d.querySelector("p").textContent=c.description||"구단 소개 없음";
  d.querySelector("button").onclick=()=>showSquad(c.name);
  $("clubList").appendChild(d);
 });
}
function showSquad(name){
 const players=read("players").filter(p=>p.club===name);
 $("squadView").innerHTML="";
 const box=document.createElement("div");box.className="card";
 const h=document.createElement("h2");h.textContent=name+" 선수단";box.appendChild(h);
 if(!players.length){const p=document.createElement("p");p.textContent="등록된 선수가 없습니다.";box.appendChild(p)}
 players.forEach(p=>{
  const r=document.createElement("div");r.className="row";
  const left=document.createElement("div");
  const t=document.createElement("p");t.textContent=(p.number||"-")+"번 · "+p.name+" ("+p.position+")";
  left.appendChild(t);
  r.appendChild(left);
  if(p.photo){const img=document.createElement("img");img.src=p.photo;img.alt=p.name;img.width=55;img.height=55;img.style.objectFit="cover";img.style.borderRadius="8px";r.appendChild(img)}
  box.appendChild(r);
 });
 $("squadView").appendChild(box);
 box.scrollIntoView({behavior:"smooth",block:"start"});
}
function renderFixtures(){
 $("fixtureList").innerHTML='<p class="muted">선택한 '+$("roundSelect").value+'라운드의 공식 대진표 데이터가 아직 연결되지 않았습니다.</p>';
}
async function addNews(){
 const title=$("newsTitle").value.trim(),body=$("newsBody").value.trim();
 if(!title||!body){alert("제목과 내용을 입력해 주세요.");return}
 let photo="";
 const file=$("newsPhoto").files[0];
 if(file){
  if(file.size>500000){alert("사진은 500KB 이하로 선택해 주세요.");return}
  photo=await fileToDataURL(file);
 }
 const news=read("news");
 news.unshift({id:Date.now(),title,body,photo,date:new Date().toLocaleDateString("ko-KR")});
 save("news",news);$("newsTitle").value="";$("newsBody").value="";$("newsPhoto").value="";
 renderNews();alert("이 브라우저에 뉴스가 저장되었습니다.");
}
function renderNews(){
 $("newsList").innerHTML="";
 const news=read("news");
 if(!news.length){$("newsList").innerHTML='<div class="card muted">등록된 뉴스가 없습니다.</div>';return}
 news.forEach(n=>{
  const d=document.createElement("div");d.className="card";
  const h=document.createElement("h3");h.textContent=n.title;d.appendChild(h);
  const date=document.createElement("small");date.textContent=n.date;d.appendChild(date);
  const p=document.createElement("p");p.textContent=n.body;d.appendChild(p);
  if(n.photo){const img=document.createElement("img");img.src=n.photo;img.alt=n.title;img.style.width="100%";img.style.borderRadius="10px";d.appendChild(img)}
  $("newsList").appendChild(d);
 });
}
function showAdmin(){
 if(!$("adminPassword").value){alert("임시 확인용 비밀번호를 입력해 주세요.");return}
 const clubs=read("clubs");
 $("adminResults").innerHTML="";
 if(!clubs.length){$("adminResults").textContent="신청 내역이 없습니다.";return}
 clubs.forEach((c,i)=>{
  const d=document.createElement("div");d.className="card";
  const h=document.createElement("h3");h.textContent=c.name;d.appendChild(h);
  const p=document.createElement("p");p.textContent=c.owner+" · "+c.contact+" · "+c.status;d.appendChild(p);
  const btn=document.createElement("button");btn.textContent="승인 처리";
  btn.onclick=()=>{
   const all=read("clubs");const item=all.find(x=>x.id===c.id);
   if(item){item.status="승인";save("clubs",all);renderClubs();updateStats();showAdmin()}
  };
  d.appendChild(btn);$("adminResults").appendChild(d);
 });
}
updateStats();renderClubs();renderNews();
</script>
</body>
</html>
