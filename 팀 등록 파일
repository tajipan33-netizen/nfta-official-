
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#061b16">
<title>NFTA OFFICIAL</title>
<style>
:root{--bg:#061b16;--panel:#102b23;--line:#285344;--green:#79edb2;--text:#f2fff8;--muted:#a9c5b8}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,sans-serif}
header{padding:22px 16px;border-bottom:1px solid var(--line)}
.logo{color:var(--green);font-size:22px;font-weight:bold}
small,.muted{color:var(--muted)}
nav{display:flex;gap:8px;padding:12px;overflow:auto}
button{background:#18392d;color:var(--text);border:1px solid var(--line);padding:12px;border-radius:10px;cursor:pointer}
button.primary{background:var(--green);color:#062018;font-weight:bold}
main{max-width:850px;margin:auto;padding:12px}
.page{display:none}.page.active{display:block}
.card{background:var(--panel);border:1px solid var(--line);padding:16px;border-radius:14px;margin:12px 0}
input,select,textarea{display:block;width:100%;margin:7px 0 14px;padding:12px;background:var(--bg);color:var(--text);border:1px solid var(--line);border-radius:9px;font:inherit}
label{font-size:14px;color:var(--muted)}
h1{font-size:24px}h2{font-size:20px}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.tag{color:var(--green);font-size:12px}
img.photo{width:76px;height:76px;object-fit:cover;border-radius:10px}
.notice{border:1px solid var(--line);padding:12px;border-radius:10px;color:var(--muted);font-size:13px}
footer{text-align:center;color:var(--muted);padding:24px}
</style>
</head>
<body>
<header>
  <div class="logo">NF · NFTA OFFICIAL</div>
  <small>NEW FANTASY LEAGUE · 공식 홈페이지</small>
</header>

<nav>
  <button onclick="page('home')">홈</button>
  <button onclick="page('clubs')">구단·선수단</button>
  <button onclick="page('login')">구단 로그인</button>
  <button onclick="page('news')">리그 뉴스</button>
</nav>

<main>
<section id="home" class="page active">
  <div class="card">
    <span class="tag">OFFICIAL LEAGUE</span>
    <h1>새로운 환상팀대결</h1>
    <p class="muted">구단별 선수 등록과 공식 뉴스 관리</p>
    <button class="primary" onclick="page('login')">구단 로그인</button>
  </div>
  <div class="card">
    <h2>참가 구단</h2>
    <p id="home-count"></p>
    <button onclick="page('clubs')">전체 구단 보기</button>
  </div>
  <div class="notice">현재 코드는 브라우저 저장 테스트 버전입니다. 여러 기기에서 공유되는 실제 운영에는 데이터베이스 연결이 필요합니다.</div>
</section>

<section id="clubs" class="page">
  <div class="card"><h2>참가 구단</h2><p class="muted">구단을 선택하면 선수단을 볼 수 있습니다.</p></div>
  <div id="club-list"></div>
  <div id="squad"></div>
</section>

<section id="login" class="page">
  <div class="card">
    <h2>구단 전용 로그인</h2>
    <label>구단 선택</label>
    <select id="login-team"></select>
    <label>구단 개인코드</label>
    <input id="login-code" type="password" autocomplete="off" placeholder="구단 개인코드 입력">
    <button class="primary" onclick="login()">로그인</button>
    <p id="login-message" role="status"></p>
  </div>
</section>

<section id="portal" class="page">
  <div class="card">
    <div class="row"><h2 id="portal-title">구단 관리</h2><button onclick="logout()">로그아웃</button></div>
    <p class="muted">이 구단에 소속된 선수와 뉴스를 등록합니다.</p>
  </div>

  <div class="card">
    <h2>선수 등록</h2>
    <form id="player-form">
      <label>선수 이름</label><input id="p-name" required maxlength="80">
      <label>포지션</label>
      <select id="p-position">
        <option>GK</option><option>DF</option><option>MF</option><option>FW</option>
      </select>
      <label>등번호</label><input id="p-number" type="number" min="1" max="99" required>
      <label>선수 사진</label><input id="p-photo" type="file" accept="image/*">
      <button class="primary" type="submit">선수 등록</button>
    </form>
    <p id="player-message" role="status"></p>
  </div>

  <div class="card">
    <h2>구단 뉴스 등록</h2>
    <form id="news-form">
      <label>뉴스 제목</label><input id="n-title" required maxlength="120">
      <label>뉴스 내용</label><textarea id="n-body" rows="5" required maxlength="5000"></textarea>
      <label>뉴스 사진</label><input id="n-photo" type="file" accept="image/*">
      <button class="primary" type="submit">뉴스 등록</button>
    </form>
    <p id="news-message" role="status"></p>
  </div>

  <div class="card"><h2>내 구단 선수단</h2><div id="my-squad"></div></div>
  <div class="card"><h2>내 구단 뉴스</h2><div id="my-news"></div></div>
</section>

<section id="news" class="page">
  <div class="card"><h2>리그 뉴스</h2><p class="muted">등록된 구단 뉴스를 확인하세요.</p></div>
  <div id="all-news"></div>
</section>
</main>

<footer>NFTA OFFICIAL · New Fantasy League</footer>

<script>
const TEAMS = [
  "FC CATALUNA",
  "TWICE FC",
  "FC BARCELOONA",
  "ONLY REDS FC",
  "엘버턴FC",
  "FC MUNCHEN",
  "FC RIVRE",
  "문덜랜드AFC",
  "FC DELPIO",
  "VANTERA ROVERS",
  "맨체스터 시티(진)",
  "진석FC",
  "말리크 산초FC",
  "CELTIC FC",
  "DOOMS",
  "Les Diables U.T.D."
];

/* 테스트용 코드입니다. 실제 보안 인증용으로 사용하지 마세요. */
const TEAM_CODES = {
  "FC CATALUNA":"CAT-7K4M",
  "TWICE FC":"TWC-8P2L",
  "FC BARCELOONA":"BAR-5N9Q",
  "ONLY REDS FC":"RED-3X6V",
  "엘버턴FC":"EVE-4H8R",
  "FC MUNCHEN":"MUN-9B2D",
  "FC RIVRE":"RIV-6F3W",
  "문덜랜드AFC":"SUN-2J7K",
  "FC DELPIO":"DEL-8C5P",
  "VANTERA ROVERS":"VAN-4Q9T",
  "맨체스터 시티(진)":"MCI-7R3N",
  "진석FC":"JIN-5W8B",
  "말리크 산초FC":"SAN-2D6X",
  "CELTIC FC":"CEL-9L4H",
  "DOOMS":"DOO-3P7C",
  "Les Diables U.T.D.":"DIA-6V2M"
};

const $ = id => document.getElementById(id);
const read = key => {
  try { return JSON.parse(localStorage.getItem("nfta_"+key)||"[]"); }
  catch { return []; }
};
const save = (key,value) =>
  localStorage.setItem("nfta_"+key,JSON.stringify(value));

let currentTeam = null;

function page(id){
  document.querySelectorAll(".page").forEach(s=>s.classList.remove("active"));
  $(id).classList.add("active");
  if(id==="clubs")renderClubs();
  if(id==="news")renderAllNews();
  if(id==="portal"&&currentTeam)renderPortal();
  window.scrollTo(0,0);
}

function safeText(tag,text,className){
  const el=document.createElement(tag);
  el.textContent=text||"";
  if(className)el.className=className;
  return el;
}

function init(){
  const select=$("login-team");
  TEAMS.forEach(team=>{
    const o=document.createElement("option");
    o.value=team;o.textContent=team;select.appendChild(o);
  });
  $("home-count").textContent=TEAMS.length+"개 구단 참가";
  renderClubs();
  renderAllNews();
}

function login(){
  const team=$("login-team").value;
  const code=$("login-code").value.trim();
  if(TEAM_CODES[team]!==code){
    $("login-message").textContent="구단 개인코드가 올바르지 않습니다.";
    return;
  }
  currentTeam=team;
  $("login-code").value="";
  $("login-message").textContent="";
  $("portal-title").textContent=team+" 구단 관리";
  page("portal");
}

function logout(){
  currentTeam=null;
  page("home");
}

function fileToDataURL(file){
  return new Promise((resolve,reject)=>{
    const reader=new FileReader();
    reader.onload=()=>resolve(reader.result);
    reader.onerror=reject;
    reader.readAsDataURL(file);
  });
}

async function readPhoto(input){
  const file=input.files[0];
  if(!file)return "";
  if(!file.type.startsWith("image/"))throw Error("이미지 파일만 선택해 주세요.");
  if(file.size>350000)throw Error("사진은 350KB 이하로 선택해 주세요.");
  return fileToDataURL(file);
}

$("player-form").addEventListener("submit",async e=>{
  e.preventDefault();
  if(!currentTeam)return;
  try{
    const players=read("players");
    const number=Number($("p-number").value);
    if(players.some(p=>p.team===currentTeam&&p.number===number)){
      $("player-message").textContent="해당 등번호가 이미 등록되어 있습니다.";
      return;
    }
    const photo=await readPhoto($("p-photo"));
    players.unshift({
      id:Date.now(),team:currentTeam,
      name:$("p-name").value.trim(),
      position:$("p-position").value,
      number,photo,
      date:new Date().toISOString()
    });
    save("players",players);
    e.target.reset();
    $("player-message").textContent="선수 등록 완료!";
    renderPortal();
    renderClubs();
  }catch(err){
    $("player-message").textContent=err.message||"선수 등록에 실패했습니다.";
  }
});

$("news-form").addEventListener("submit",async e=>{
  e.preventDefault();
  if(!currentTeam)return;
  try{
    const photo=await readPhoto($("n-photo"));
    const news=read("news");
    news.unshift({
      id:Date.now(),team:currentTeam,
      title:$("n-title").value.trim(),
      body:$("n-body").value.trim(),
      photo,date:new Date().toISOString()
    });
    save("news",news);
    e.target.reset();
    $("news-message").textContent="뉴스 등록 완료!";
    renderPortal();
    renderAllNews();
  }catch(err){
    $("news-message").textContent=err.message||"뉴스 등록에 실패했습니다.";
  }
});

function renderClubs(){
  const root=$("club-list");root.replaceChildren();
  TEAMS.forEach(team=>{
    const players=read("players").filter(p=>p.team===team);
    const box=document.createElement("div");box.className="card";
    const row=document.createElement("div");row.className="row";
    const left=document.createElement("div");
    left.appendChild(safeText("h3",team));
    left.appendChild(safeText("p",players.length+"명 등록 선수","muted"));
    const btn=safeText("button","선수단 보기");
    btn.onclick=()=>showSquad(team);
    row.append(left,btn);box.appendChild(row);root.appendChild(box);
  });
}

function showSquad(team){
  const root=$("squad");root.replaceChildren();
  const box=document.createElement("div");box.className="card";
  box.appendChild(safeText("h2",team+" 선수단"));
  const players=read("players").filter(p=>p.team===team);
  if(!players.length)box.appendChild(safeText("p","등록된 선수가 없습니다.","muted"));
  players.forEach(p=>{
    const row=document.createElement("div");row.className="row";
    const info=document.createElement("div");
    info.appendChild(safeText("strong",p.number+"번 · "+p.name));
    info.appendChild(safeText("p",p.position,"muted"));
    row.appendChild(info);
    if(p.photo){
      const img=document.createElement("img");
      img.src=p.photo;img.alt=p.name;img.className="photo";row.appendChild(img);
    }
    box.appendChild(row);
  });
  root.appendChild(box);
  box.scrollIntoView({behavior:"smooth",block:"start"});
}

function renderPortal(){
  if(!currentTeam)return;
  const players=read("players").filter(p=>p.team===currentTeam);
  const root=$("my-squad");root.replaceChildren();
  if(!players.length)root.appendChild(safeText("p","등록된 선수가 없습니다.","muted"));
  players.forEach(p=>{
    const row=document.createElement("div");row.className="row";
    row.appendChild(safeText("p",p.number+"번 · "+p.name+" ("+p.position+")"));
    if(p.photo){
      const img=document.createElement("img");img.src=p.photo;img.className="photo";img.alt=p.name;row.appendChild(img);
    }
    root.appendChild(row);
  });
  const newsRoot=$("my-news");newsRoot.replaceChildren();
  const news=read("news").filter(n=>n.team===currentTeam);
  if(!news.length)newsRoot.appendChild(safeText("p","등록된 뉴스가 없습니다.","muted"));
  news.forEach(n=>newsRoot.appendChild(newsCard(n)));
}

function newsCard(n){
  const box=document.createElement("div");box.className="card";
  box.appendChild(safeText("h3",n.title));
  box.appendChild(safeText("small",n.team+" · "+new Date(n.date).toLocaleString("ko-KR")));
  box.appendChild(safeText("p",n.body));
  if(n.photo){
    const img=document.createElement("img");img.src=n.photo;img.alt=n.title;
    img.style.width="100%";img.style.borderRadius="10px";box.appendChild(img);
  }
  return box;
}

function renderAllNews(){
  const root=$("all-news");root.replaceChildren();
  const news=read("news");
  if(!news.length){
    root.appendChild(safeText("div","등록된 뉴스가 없습니다.","card muted"));
    return;
  }
  news.forEach(n=>root.appendChild(newsCard(n)));
}

init();
</script>
</body>
</html>
